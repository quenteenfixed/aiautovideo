            "transition_in": "fade",
            "transition_out": "slide_left"
        },
        {
            "scene_id": 2,
            "narration": "答案藏在一个你可能从没听过的词里：预测窗口。",
            "duration": 5,
            "visual": {
                "type": "text_card",
                "title": "预测窗口",
                "subtitle": "今天只讲这一个概念",
